    if (!contenidoCarta.hidden) {
      contenidoCarta.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    }
  });

  // RECUERDOS Y MENSAJES
  const recuerdos = [
    {
      foto: "/fotos/foto1.jpg.jpeg",
      titulo: "Un pedacito de felicidad",
      mensaje: "Hay momentos que parecen pequeños cuando suceden, pero que con el tiempo se convierten en recuerdos muy especiales. Esta fotografía guarda uno de esos pedacitos de nuestra historia. Me gusta pensar que, entre tantas cosas que pasan en la vida, también tenemos instantes que merecen quedarse para siempre en nuestra memoria. Gracias por formar parte de este recuerdo y de todo lo bonito que hemos compartido."
    },
    {
      foto: "/fotos/foto2.jpg.jpeg",
      titulo: "Mi recuerdo favorito",
      mensaje: "Cada fotografía tiene algo que contar y esta es una de esas que quiero conservar con mucho cariño. Me recuerda que no hacen falta grandes acontecimientos para tener momentos importantes. A veces basta una imagen, una conversación o un instante compartido para encontrar una razón para sonreír. Ojalá nunca dejemos de valorar esos pequeños detalles que hacen especial nuestra historia."
    },
    {
      foto: "/fotos/foto3.jpg.jpeg",
      titulo: "Siempre nosotros",
      mensaje: "Nuestra historia está formada por diferentes etapas, por días tranquilos, por aprendizajes y por momentos que nos han enseñado a conocernos mejor. No todo tiene que ser perfecto para tener valor. Lo importante es recordar lo que hemos vivido, aprender de cada experiencia y tratar de construir momentos cada vez más bonitos. Esta fotografía es una pequeña parte de ese camino."
    },
    {
      foto: "/fotos/foto4.jpg.jpeg",
      titulo: "Pequeños instantes",
      mensaje: "A veces los momentos más sencillos terminan siendo los que más recordamos. Una fotografía puede guardar sentimientos, detalles y recuerdos que las palabras no siempre consiguen explicar. Por eso quise darle un espacio aquí. Para que podamos volver a verla y recordar que nuestra historia también está hecha de esos instantes cotidianos que merecen ser apreciados."
    },
    {
      foto: "/fotos/foto5.jpg.jpeg",
      titulo: "Mi lugar favorito",
      mensaje: "No siempre se necesita un lugar extraordinario para guardar un recuerdo bonito. Lo especial muchas veces está en las personas, en las experiencias y en lo que sentimos al recordar un momento. Esta imagen forma parte de ese pequeño álbum que reúne una parte de nosotros. Quiero que cuando la mires recuerdes que cada detalle de nuestra historia tiene un significado."
    },
    {
      foto: "/fotos/foto6.jpg.jpeg",
      titulo: "Lo bonito de coincidir",
      mensaje: "Entre tantas personas, tantos caminos y tantas historias, nuestras vidas llegaron a encontrarse. Y aunque no podemos saber todo lo que nos espera, sí podemos valorar lo que hemos vivido hasta ahora. Esta fotografía es un recordatorio de esa coincidencia y de los momentos que hemos podido compartir. Qué bonito es tener recuerdos que nos permitan volver a esos días."
    },
    {
      foto: "/fotos/foto7.jpg.jpeg",
      titulo: "Un recuerdo para siempre",
      mensaje: "Hay recuerdos que no necesitan demasiadas explicaciones porque su valor está en lo que representan para nosotros. Esta fotografía es una pequeña parte de nuestra historia y quiero conservarla como algo especial. Que nunca nos falten motivos para mirar atrás con cariño, reconocer cuánto hemos aprendido y seguir creando nuevos momentos que algún día también podamos recordar."
    },
    {
      foto: "/fotos/foto8.jpg.jpeg",
      titulo: "Momentos nuestros",
      mensaje: "Cada etapa deja algo diferente: una enseñanza, una sonrisa, una conversación o una experiencia que se queda guardada en la memoria. Me gusta pensar que todas esas pequeñas cosas forman el álbum de nuestra historia. Esta imagen tiene su propio espacio porque también merece ser recordada. Gracias por cada momento compartido y por todo lo que todavía podemos aprender."
    },
    {
      foto: "/fotos/foto9.jpg.jpeg",
      titulo: "Y los que faltan",
      mensaje: "Este álbum tiene nueve fotografías, pero nuestra historia no termina aquí. Todavía quedan fechas por celebrar, canciones por escuchar, conversaciones por compartir y muchos recuerdos que podemos crear. Quise dejar este último espacio como una manera de mirar hacia adelante con ilusión. Que podamos seguir escribiendo nuestra historia con cariño, respeto, paciencia y muchas razones para sonreír."
    }
  ];

  // ABRIR LAS TARJETAS
  const modal = obtener("modalRecuerdo");

  function abrirRecuerdo(indice) {
    const recuerdo = recuerdos[indice];

    if (!recuerdo) return;

    obtener("modalImagen").src = recuerdo.foto;
    obtener("modalTitulo").textContent = recuerdo.titulo;
    obtener("modalMensaje").textContent = recuerdo.mensaje;

    modal.classList.add("modal-abierto");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("sin-scroll");
  }

  function cerrarRecuerdo() {
    modal.classList.remove("modal-abierto");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("sin-scroll");
  }

  document.querySelectorAll(".tarjeta").forEach((tarjeta) => {
    tarjeta.addEventListener("click", () => {
      abrirRecuerdo(Number(tarjeta.dataset.foto));
    });
  });

  obtener("cerrarModal").addEventListener("click", cerrarRecuerdo);

  modal.addEventListener("click", (evento) => {
    if (evento.target === modal) cerrarRecuerdo();
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape") {
      cerrarRecuerdo();
    }
  });
</script>

