<script is:inline>
  // ELEMENTOS GENERALES
  const obtener = (id) => document.getElementById(id);

  // DESBLOQUEO AUTOMÁTICO DE LA PÁGINA
  const fechaDesbloqueo = new Date("2026-11-19T00:00:00-05:00").getTime();
  const pantallaEspera = obtener("pantallaEspera");

  function actualizarDesbloqueo() {
    const restanteEspera = fechaDesbloqueo - Date.now();

    if (restanteEspera <= 0) {
      pantallaEspera.hidden = true;
      return;
    }

    pantallaEspera.hidden = false;

    obtener("esperaDias").textContent = String(
      Math.floor(restanteEspera / 86400000)
    ).padStart(2, "0");

    obtener("esperaHoras").textContent = String(
      Math.floor((restanteEspera % 86400000) / 3600000)
    ).padStart(2, "0");

    obtener("esperaMinutos").textContent = String(
      Math.floor((restanteEspera % 3600000) / 60000)
    ).padStart(2, "0");

    obtener("esperaSegundos").textContent = String(
      Math.floor((restanteEspera % 60000) / 1000)
    ).padStart(2, "0");
  }

  actualizarDesbloqueo();

  const intervaloDesbloqueo = setInterval(() => {
    actualizarDesbloqueo();

    if (Date.now() >= fechaDesbloqueo) {
      clearInterval(intervaloDesbloqueo);
    }
  }, 1000);

  // MENÚ PARA CELULARES
  const menuToggle = obtener("menuToggle");
  const menu = obtener("menu");

  menuToggle.addEventListener("click", () => {
    menu.classList.toggle("menu-abierto");
  });

  menu.querySelectorAll("a").forEach((enlace) => {
    enlace.addEventListener("click", () => {
      menu.classList.remove("menu-abierto");
    });
  });

  // CONTADOR DE TIEMPO
  const inicio = new Date("2025-05-19T00:00:00-05:00").getTime();
  const fechaAniversario = new Date("2026-11-19T00:00:00-05:00").getTime();

  function actualizarContadores() {
    const ahora = Date.now();
    const transcurrido = Math.max(0, ahora - inicio);
    const restante = Math.max(0, fechaAniversario - ahora);

    obtener("dias").textContent = Math.floor(transcurrido / 86400000);

    obtener("horas").textContent = String(
      Math.floor((transcurrido % 86400000) / 3600000)
    ).padStart(2, "0");

    obtener("minutos").textContent = String(
      Math.floor((transcurrido % 3600000) / 60000)
    ).padStart(2, "0");

    obtener("segundos").textContent = String(
      Math.floor((transcurrido % 60000) / 1000)
    ).padStart(2, "0");

    obtener("cdias").textContent = Math.floor(restante / 86400000);

    obtener("choras").textContent = String(
      Math.floor((restante % 86400000) / 3600000)
    ).padStart(2, "0");

    obtener("cminutos").textContent = String(
      Math.floor((restante % 3600000) / 60000)
    ).padStart(2, "0");

    obtener("csegundos").textContent = String(
      Math.floor((restante % 60000) / 1000)
    ).padStart(2, "0");

    obtener("mensajeCuenta").textContent =
      restante === 0
        ? "Una fecha especial para recordar ♡"
        : "Cada segundo es una nueva oportunidad para crear recuerdos.";
  }

  actualizarContadores();
  setInterval(actualizarContadores, 1000);

  // BOTÓN PARA ABRIR NUESTRA LISTA DE SPOTIFY
  const botonMusica = obtener("iniciarMusica");

  botonMusica.addEventListener("click", () => {
    window.open(
      "https://open.spotify.com/playlist/7wLdnNferEN3IH6IMJgMMw?si=HLmkjE8nTK-zEwZp8YP0xA",
      "_blank",
      "noopener,noreferrer"
    );
  });

  // CARTA
  const botonCarta = obtener("abrirCarta");
  const contenidoCarta = obtener("contenidoCarta");

  botonCarta.addEventListener("click", () => {
    contenidoCarta.hidden = !contenidoCarta.hidden;

    botonCarta.textContent = contenidoCarta.hidden
