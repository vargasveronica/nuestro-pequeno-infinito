  /* RECUERDOS */
  .recuerdos {
    background: var(--crema);
    color: var(--vino);
  }

  .recuerdos .etiqueta {
    color: #987044;
  }

  .recuerdos .ornamento {
    color: #ad8050;
  }

  .recuerdos .introduccion {
    color: #775e69;
  }

  .galeria {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .tarjeta {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid #d2b38a;
    background: #fffaf6;
    color: var(--vino);
    text-align: left;
    cursor: pointer;
    box-shadow: 0 9px 25px #3b1c2b12;
    transition: transform .3s, box-shadow .3s;
    font-family: "Montserrat", sans-serif;
  }

  .tarjeta:hover {
    transform: translateY(-7px);
    box-shadow: 0 18px 35px #3b1c2b25;
  }

  .foto-tarjeta {
    width: 100%;
    height: 245px;
    position: relative;
    overflow: hidden;
    background: #e7d8d9;
  }

  .foto-tarjeta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s;
  }

  .tarjeta:hover .foto-tarjeta img {
    transform: scale(1.04);
  }

  .foto-tarjeta span {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: #29151fe8;
    color: var(--dorado);
    padding: 6px 10px;
    font: 16px "Cormorant Garamond", serif;
  }

  .texto-tarjeta {
    padding: 16px 8px 10px;
  }

  .texto-tarjeta h3 {
    font-size: 26px;
    line-height: 1.05;
    margin: 0 0 8px;
    color: #65364d;
  }

  .texto-tarjeta p {
    color: #826a75;
    font-size: 10px;
    margin: 0 0 14px;
    line-height: 1.6;
  }

  .texto-tarjeta small {
    color: #9b7951;
    font-size: 8px;
    letter-spacing: 1.5px;
    font-weight: 600;
  }

  /* FRASE FINAL */
  .frase-final {
    padding: 100px 8%;
    text-align: center;
    background:
      radial-gradient(ellipse at center, #62374d, #301a27 75%);
  }

  .frase-final > span {
    display: block;
    font-size: 45px;
    color: var(--dorado);
    margin-bottom: 18px;
  }

  .frase-final .etiqueta {
    color: var(--dorado);
  }

  .frase-final h2 {
    max-width: 800px;
    margin: 25px auto;
    font-size: clamp(32px, 5vw, 48px);
  }

  .frase-final > p:last-child {
    color: var(--rosa);
    font: 23px "Parisienne", cursive;
  }

  /* CARTA */
  .carta {
    background: #f2e8e1;
    color: var(--vino);
  }

  .carta .etiqueta {
    color: #987044;
  }

  .carta .introduccion {
    color: #775e69;
  }

  .sobre {
    max-width: 500px;
    margin: auto;
    padding: 45px 25px;
    background: #fffaf6;
    border: 1px solid #c7a77c;
    text-align: center;
    box-shadow: 0 15px 35px #3d243018;
  }

  .sello {
    width: 65px;
    height: 65px;
    display: grid;
    place-items: center;
    margin: auto;
    border-radius: 50%;
    background: #482638;
    color: var(--dorado);
    font-size: 30px;
  }

  .sobre p {
    font: 26px "Parisienne", cursive;
    color: #78465c;
  }

  .boton-carta {
    color: var(--vino);
    background: transparent;
    cursor: pointer;
  }

  .boton-carta:hover {
    color: var(--crema);
    background: var(--vino);
  }

  .contenido-carta {
    max-width: 850px;
    margin: 35px auto 0;
    padding: 55px;
    background: #fffaf6;
    border: 1px solid #c7a77c;
    box-shadow: 0 15px 35px #3d243018;
    color: #654b57;
    font-size: 13px;
    line-height: 2;
    animation: aparecer .5s ease;
  }

  .contenido-carta p {
    margin: 18px 0;
  }

  .titulo-carta {
    text-align: center;
    color: #79435b;
    font: 36px "Parisienne", cursive;
    margin: 0 0 30px;
  }

  .contenido-carta .saludo-carta {
    font: 30px "Parisienne", cursive;
    color: #a15e79;
  }

  .frase-destacada-carta {
    color: #8d506b;
    font: 23px "Cormorant Garamond", serif;
    text-align: center;
    line-height: 1.6;
    padding: 15px 10px;
    border-top: 1px solid #c7a77c80;
    border-bottom: 1px solid #c7a77c80;
  }

  .firma-carta {
    text-align: right;
    font: 30px "Parisienne", cursive;
    color: #a15e79;
    margin-top: 35px !important;
  }

  /* PIE */
  footer {
    background: #1d1017;
    text-align: center;
    padding: 55px 20px;
  }

  .corazon-footer {
    color: var(--dorado);
    font-size: 38px;
  }

  footer p {
    font: 27px "Cormorant Garamond", serif;
  }

  footer small {
    display: block;
    color: #c7b1bb;
    font-size: 10px;
    margin: 8px;
  }

  .volver {
    display: inline-block;
    margin-top: 25px;
    color: var(--dorado);
    text-decoration: none;
    font-size: 9px;
    letter-spacing: 2px;
  }

  /* MODAL DE RECUERDOS */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 25px;
    background: #120a10ed;
    overflow-y: auto;
  }

  .modal.modal-abierto {
    display: flex;
  }

  .modal-contenido {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--crema);
    color: var(--vino);
    box-shadow: 0 20px 70px #0008;
    animation: aparecer .35s ease;
  }

  .cerrar-modal {
    position: absolute;
    top: 10px;
    right: 14px;
    z-index: 3;
    width: 38px;
    height: 38px;
    border: 1px solid #d8b77e;
    border-radius: 50%;
    background: #fffaf6;
    color: var(--vino);
    font-size: 27px;
    cursor: pointer;
  }

  .modal-imagen {
    min-height: 420px;
    background: #d9c5c9;
  }

  .modal-imagen img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: block;
    object-fit: cover;
  }

  .modal-texto {
    padding: 65px 40px 35px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .modal-texto .etiqueta {
    color: #9b7951;
    font-size: 8px;
  }

  .modal-texto h2 {
    color: #65364d;
    font-size: 40px;
  }

  .modal-texto .ornamento {
    color: #b18a5b;
    margin: 15px 0;
  }

  .modal-texto p {
    color: #765d68;
    font-size: 12px;
    line-height: 2;
    white-space: normal;
  }

  .modal-corazon {
    color: #b87991;
    font-size: 32px;
    text-align: right;
    margin-top: 15px;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* TABLET */
  @media (max-width: 900px) {
    .historia-contenido {
      gap: 35px;
    }

    .galeria {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .foto-tarjeta {
      height: 230px;
    }
  }

  /* CELULAR */
  @media (max-width: 650px) {
    .navegacion {
      min-height: 65px;
      padding: 10px 18px;
      flex-wrap: wrap;
    }

    .marca {
      font-size: 23px;
    }

    .menu-toggle {
      display: block;
    }

    .menu {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0;
    }

    .menu.menu-abierto {
      display: flex;
    }

    .menu a {
      padding: 13px 8px;
      border-top: 1px solid #d8b77e20;
      font-size: 11px;
    }

    .portada {
      min-height: 620px;
      padding: 55px 25px;
    }

    .portada-marco {
      padding: 50px 17px;
    }

    .portada h1 {
      font-size: clamp(48px, 13vw, 70px);
    }

    .nombres-portada {
      font-size: 30px;
    }

    .decoracion {
      font-size: 32px;
    }

    .decoracion-uno {
      left: 4%;
      top: 7%;
    }

    .decoracion-dos {
      right: 4%;
      bottom: 8%;
    }

    .decoracion-tres {
      right: 5%;
      top: 13%;
    }

    .seccion {
      padding: 75px 20px;
    }

    .encabezado {
      margin-bottom: 38px;
    }

    h2 {
      font-size: 39px;
    }

    .introduccion {
      font-size: 12px;
    }

    .historia-contenido {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .historia-imagen img {
      height: 320px;
    }

    .historia-texto {
      font-size: 13px;
    }

    .musica-contenedor {
      padding: 25px 15px;
    }

    .musica-titulo {
      font-size: 28px;
    }

    .musica-contenedor iframe {
      height: 380px;
    }

    .contador-marco {
      padding: 30px 12px;
    }

    .contador {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .contador div {
      min-width: 0;
      padding: 15px 5px;
    }

    .contador strong {
      font-size: 38px;
    }

    .contador span {
      font-size: 8px;
    }

    .proximo-aniversario {
      padding: 28px 12px;
    }

    .proximo-aniversario h3 {
      font-size: 29px;
    }

    .capitulos-lista {
      padding-left: 28px;
    }

    .numero-capitulo {
      left: -46px;
    }

    .capitulo {
      padding-left: 10px;
    }

    .capitulo h3 {
      font-size: 25px;
    }

    .capitulo p {
      font-size: 11px;
    }

    .galeria {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .tarjeta {
      padding: 7px;
    }

    .foto-tarjeta {
      height: 175px;
    }

    .texto-tarjeta {
      padding: 12px 5px 8px;
    }

    .texto-tarjeta h3 {
      font-size: 21px;
    }

    .texto-tarjeta p {
      font-size: 9px;
    }

    .texto-tarjeta small {
      font-size: 7px;
      letter-spacing: .8px;
    }

    .frase-final {
      padding: 75px 22px;
    }

    .frase-final h2 {
      font-size: 35px;
    }

    .contenido-carta {
      padding: 30px 20px;
      font-size: 12px;
    }

    .titulo-carta {
      font-size: 30px;
    }

    .frase-destacada-carta {
      font-size: 21px;
    }

    .modal {
      padding: 12px;
      align-items: center;
    }

    .modal-contenido {
      grid-template-columns: 1fr;
      max-height: 94vh;
      width: 100%;
    }

    .modal-imagen {
      min-height: 0;
      height: 260px;
    }

    .modal-imagen img {
      min-height: 0;
      height: 260px;
    }

    .modal-texto {
      padding: 28px 23px 25px;
    }

    .modal-texto h2 {
      font-size: 34px;
      padding-right: 15px;
    }

    .modal-texto p {
      font-size: 12px;
      line-height: 1.8;
    }

    .cerrar-modal {
      top: 8px;
      right: 8px;
    }

    .espera-marco {
      padding: 35px 12px;
    }

    .contador-espera {
      gap: 5px;
    }

    .contador-espera strong {
      font-size: 27px;
    }

    .contador-espera span {
      font-size: 7px;
    }
  }

  /* CELULARES MUY PEQUEÑOS */
  @media (max-width: 370px) {
    .galeria {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .foto-tarjeta {
      height: 260px;
    }

    .texto-tarjeta h3 {
      font-size: 25px;
    }

    .portada h1 {
      font-size: 47px;
    }

    .etiqueta-portada {
      font-size: 8px;
      letter-spacing: 2px;
    }
  }
</style>

